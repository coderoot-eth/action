{
  "name": "@coderoot-eth/verify",
  "version": "0.1.1",
  "description": "Verify that the dependencies and artifacts you use are the bytes their publisher released, against CodeRoot's public attestations. The hash is the trust; a name and version alone never verify.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderoot-eth/verify.git"
  },
  "homepage": "https://github.com/coderoot-eth/verify#readme",
  "bugs": {
    "url": "https://github.com/coderoot-eth/verify/issues"
  },
  "keywords": [
    "supply-chain",
    "sbom",
    "attestation",
    "npm",
    "verification",
    "cyclonedx",
    "spdx"
  ],
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "bin": {
    "coderoot": "./build/bin/coderoot.js"
  },
  "files": [
    "build/lib",
    "build/bin",
    "LICENSE",
    "NOTICE",
    "README.md",
    "AGENTS.md",
    "spec"
  ],
  "workspaces": [
    "mcp"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepack": "npm run clean && npm run build",
    "coderoot": "ts-node bin/coderoot.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/hashes": "^1.3.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
